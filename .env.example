# General
APP_ENV=development
LOG_LEVEL=INFO

# Database is optional for the initial local scaffold. Never commit actual credentials.
DATABASE_URL=sqlite+aiosqlite:///./data/xsentiment.db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=5
DB_POOL_TIMEOUT_SECONDS=30

# External providers (leave blank until their usage and access terms are confirmed)
APIFY_API_TOKEN=
APIFY_ACTOR_ID=
TAVILY_API_KEY=
EXA_API_KEY=

# Price provider / asset scope will be configured during canonical requirements.
PRICE_PROVIDER=
PRICE_PROVIDER_API_KEY=
ASSET_SYMBOL=
ASSET_CLASS=

# Request safety
HTTP_TIMEOUT_SECONDS=20
HTTP_MAX_CONCURRENCY=8
HTTP_MAX_RETRIES=3
HTTP_MAX_RESPONSE_BYTES=5000000
